{
  "name": "@thegetget/get-agent",
  "version": "1.2.0",
  "description": "A lightweight AI Agent framework in TypeScript with Zod validation, tool calling, and MCP support.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "patch": "npm version patch && npm run build && npm pack && npm publish --access=public"
  },
  "keywords": [
    "ai",
    "agent",
    "mcp",
    "zod",
    "typescript"
  ],
  "author": "Gaëtan BIORD",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "typescript": "^5.4.5",
    "zod": "^4.4.3",
    "vitest": "^3.2.4"
  }
}
